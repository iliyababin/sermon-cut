{
  "$schema": "https://schemas.tauri.app/capability/2.0.0",
  "identifier": "default",
  "description": "Default capabilities for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:default",
    "shell:default",
    "shell:allow-open",
    "dialog:default",
    "updater:default",
    "process:allow-restart",
    "notification:default",
    "log:default"
  ]
}
